# FNL:004 · ejemplo de variables de entorno
# Copia a .env y rellena tus claves. NO subas .env a git.

# ── LLM principal / fallback ────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Router multi-proveedor (ver docs/LLM_ROUTER.md)
LLM_ROUTER_ENABLED=true
LLM_ROUTER_MAX_ATTEMPTS=6
LLM_ROUTER_COOLDOWN_SEC=90

# Ejemplo 1: Groq (free tier)
# LLM_PROVIDER_1_NAME=groq
# LLM_PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
# LLM_PROVIDER_1_MODEL=openai/gpt-oss-20b
# LLM_PROVIDER_1_API_KEYS=clave1,clave2
# LLM_PROVIDER_1_PRIORITY=10
# LLM_PROVIDER_1_JSON_MODE=true

# Ejemplo 2: Gemini (free tier)
# LLM_PROVIDER_2_NAME=gemini
# LLM_PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_PROVIDER_2_MODEL=gemini-2.5-flash
# LLM_PROVIDER_2_API_KEY=clave
# LLM_PROVIDER_2_PRIORITY=20

# Ejemplo 3: Meta Model API (Muse Spark; PAGO, no usa los 100M de la app Muse)
# LLM_PROVIDER_9_NAME=meta
# LLM_PROVIDER_9_BASE_URL=https://api.meta.ai/v1
# LLM_PROVIDER_9_MODEL=muse-spark-1.3
# LLM_PROVIDER_9_API_KEY=clave_meta
# LLM_PROVIDER_9_PRIORITY=90

# ── Datos / ZMQ ─────────────────────────────────────────────
ZMQ_PC_IP=172.29.16.1

# ── Noticias (opcional) ─────────────────────────────────────
# FINNHUB_API_KEY=
# FXNEWSBIAS_KEY=
# TRADEKIX_API_KEY=
# JBNEWS_API_KEY=

# ── Telegram ────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false
# TELEGRAM_MIN_SEVERITY=INFO
# TELEGRAM_RATE_LIMIT_SECONDS=1.5

# ── EA monitor ──────────────────────────────────────────────
EA_MONITOR_ENABLED=true
